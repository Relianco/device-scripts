{
  "schema": 1,
  "id": "azure-ad-sso-zone",
  "title": "Trust Azure AD sign-in for the local intranet",
  "description": "Sets the microsoftazuread-sso.com autologon zone value https to 1.",
  "steps": [
    {
      "kind": "registry",
      "op": "set",
      "hive": "HKLM",
      "path": "Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\ZoneMap\\Domains\\microsoftazuread-sso.com\\autologon",
      "name": "https",
      "type": "dword",
      "value": 1
    }
  ]
}
